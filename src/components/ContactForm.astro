---
import { site } from '../data/site';
const topics = [
  { value: 'hiring', label: 'Hiring', prompt: 'Tell me about the role' },
  { value: 'mentoring', label: 'Mentoring', prompt: 'What would you like to talk about?' },
  { value: 'hi', label: 'Just saying hi', prompt: 'Message' },
];
const action = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : '';
---
<section id="contact" class="panel">
  <div class="ink-layer" aria-hidden="true">
    <div class="ink drift" style="width: 380px; height: 380px; left: -6%; bottom: -30%; background: var(--accent); opacity: 0.55"></div>
    <div class="ink drift" style="width: 320px; height: 320px; right: 10%; top: -30%; background: var(--turquoise); opacity: 0.4; animation-duration: 36s"></div>
  </div>
  <div class="intro">
    <h2>Get in touch</h2>
    <p>Or find me on <a href={site.linkedin}>LinkedIn</a>.</p>
  </div>
  <form class="form" method="POST" action={action} data-ready={action ? 'true' : 'false'}>
    <fieldset>
      <legend>What’s this about?</legend>
      <div class="topics">
        {topics.map((t, i) => (
          <label class="topic">
            <input type="radio" name="topic" value={t.value} data-prompt={t.prompt} checked={i === 2} class="sr-only" />
            {t.label}
          </label>
        ))}
      </div>
    </fieldset>
    <label>Your name<input name="name" type="text" required autocomplete="name" /></label>
    <label>Your email, so I can reply<input name="email" type="email" required autocomplete="email" /></label>
    <label><span class="msg-label">Message</span><textarea name="message" rows="4" required></textarea></label>
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
    <button type="submit" class="btn send">Send</button>
    <p class="status" role="status"></p>
  </form>
</section>

<style>
  .panel {
    position: relative; overflow: hidden; display: flex; flex-wrap: wrap; gap: 48px;
    margin: 72px 0; padding: 56px; border-radius: 28px; background: var(--ink); color: var(--card);
  }
  .intro { position: relative; flex: 1 1 260px; display: flex; flex-direction: column; gap: 16px; }
  h2 { font-size: 48px; line-height: 1.1; }
  .intro p { margin: 0; color: #D5DCE6; }
  .intro a { color: var(--card); }
  .form { position: relative; flex: 1 1 340px; display: flex; flex-direction: column; gap: 16px; }
  fieldset { margin: 0; padding: 0; border: 0; }
  legend { padding: 0 0 8px; font-size: 14px; }
  .topics { display: flex; flex-wrap: wrap; gap: 8px; }
  .topic {
    display: inline-flex; flex-direction: row; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px;
    font-size: 15px; font-weight: 500; cursor: pointer; border: 1px solid rgba(248,250,252,0.55);
  }
  .topic:has(input:checked) { background: var(--card); color: var(--ink); border-color: var(--card); }
  .topic:focus-within { outline: 2px solid var(--card); outline-offset: 2px; }
  label:not(.topic) { display: flex; flex-direction: column; gap: 6px; font-size: 14px; }
  input:not([type='radio']), textarea {
    min-height: 44px; padding: 10px 14px; border: 0; border-radius: 10px; background: var(--card);
    font: inherit; font-size: 16px; color: var(--ink);
  }
  textarea { resize: vertical; }
  input:focus, textarea:focus { outline: 2px solid var(--card); outline-offset: 2px; }
  .send { align-self: flex-start; background: var(--card); color: var(--ink); border: 0; }
  .status { margin: 0; min-height: 1.6em; }
  @media (max-width: 760px) {
    .panel { padding: 32px 20px; margin: 48px 0; gap: 32px; }
    h2 { font-size: 36px; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact form');
  if (form) {
    const msgLabel = form.querySelector<HTMLElement>('.msg-label')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    form.querySelectorAll<HTMLInputElement>('input[name="topic"]').forEach((r) =>
      r.addEventListener('change', () => { msgLabel.textContent = r.dataset.prompt || 'Message'; }),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.dataset.ready !== 'true') {
        status.textContent = 'The form is not connected yet. Please reach me on LinkedIn for now.';
        return;
      }
      const button = form.querySelector('button')!;
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error();
        const topic = (form.querySelector('input[name="topic"]:checked') as HTMLInputElement)?.value;
        (window as any).goatcounter?.count?.({ path: `message-sent-${topic}`, title: 'Message sent', event: true });
        form.reset();
        status.textContent = 'Thank you, your message is on its way and I’ll reply soon.';
      } catch {
        status.textContent = 'Something went wrong. Please try again, or reach me on LinkedIn.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
---
<header class="nav">
  <a href="/" class="home" aria-label="Home">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5.5 9v11h13V9"></path><path d="M10 20v-5h4v5"></path></svg>
  </a>
  <nav aria-label="Main">
    {nav.map((item) => (
      <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <a href={site.cv} class="accent" data-track="cv-download">CV</a>
    <a href={site.linkedin} class="accent" data-track="linkedin">LinkedIn</a>
  </nav>
</header>

<style>
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 24px 0; }
  .home {
    display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto;
    width: 44px; height: 44px; border-radius: 999px; color: var(--ink); background: rgba(255,255,255,0.45);
  }
  nav { display: flex; gap: 28px; font-size: 15px; white-space: nowrap; }
  nav a { color: var(--ink); text-decoration: none; padding: 10px 0; }
  nav a[aria-current='page'] { text-decoration: underline; }
  nav a.accent { color: var(--accent); }
  nav a:hover { text-decoration: underline; }
  @media (max-width: 760px) {
    .nav { gap: 8px; }
    .home { width: 36px; height: 36px; }
    nav { gap: 11px; font-size: 13px; }
  }
  @media (max-width: 370px) {
    nav { flex-wrap: wrap; justify-content: flex-end; column-gap: 10px; row-gap: 0; }
  }
</style>

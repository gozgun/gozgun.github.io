---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ComingSoon from '../components/ComingSoon.astro';
import ShelfObject from '../components/ShelfObject.astro';
import Contact from '../components/Contact.astro';
import { books, products, podcasts, shelfColors } from '../data/shelf';

const now = [
  'Shipping a calmer way to create lessons',
  'Taking structured PM courses',
  'Building intentionally with AI tools',
];
---
<Base ownNav>
  <Hero />
  <div class="wrap">
    <section class="section about">
      <p class="statement">I’m an engineer by training who fell for the messy part before the code, when nobody is quite sure yet <span>what the user really needs</span>.</p>
      <div class="card now">
        <p class="label">Now</p>
        <ul>{now.map((n) => <li>{n}</li>)}</ul>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2 class="section-title">Field notes</h2></div>
      <ComingSoon />
    </section>

    <section class="section">
      <div class="section-head">
        <h2 class="section-title">On my shelf</h2>
        <a href="/shelf/">Browse the shelf →</a>
      </div>
      <div class="mini-shelf">
        <div class="row">
          {books.slice(0, 3).map((b, i) => (
            <ShelfObject item={b} kind="book" index={i} color={shelfColors[i]} href="/shelf/" />
          ))}
          <span class="gap"></span>
          {products.map((p, i) => (
            <ShelfObject item={p} kind="product" index={i} color={shelfColors[(i + 3) % 8]} href="/shelf/" />
          ))}
          <span class="gap"></span>
          <ShelfObject item={podcasts[0]} kind="podcast" index={0} color={shelfColors[6]} href="/shelf/" />
        </div>
        <div class="plank" aria-hidden="true"></div>
      </div>
    </section>

    <Contact />
  </div>
</Base>

<style>
  .about { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .statement { margin: 0; flex: 2 1 480px; min-width: 0; font-family: var(--display); font-weight: 500; letter-spacing: -0.015em; font-size: 34px; line-height: 1.3; }
  .statement span { color: var(--accent); }
  .now { flex: 1 1 260px; padding: 24px; border-radius: 14px; }
  .now .label { margin-bottom: 12px; }
  .now ul { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 8px; color: var(--ink-2); font-size: 16px; }
  .mini-shelf .row { display: flex; align-items: flex-end; gap: 6px; overflow-x: auto; padding: 16px 16px 0; }
  .mini-shelf .gap { flex: 0 0 22px; }
  .mini-shelf :global(.frame) { width: 92px; height: 92px; margin-right: 10px; }
  .plank { height: 12px; border-radius: 3px; background: var(--wood); box-shadow: 0 10px 18px rgba(22,32,43,0.10); }
  @media (max-width: 760px) { .statement { font-size: 26px; } }
</style>
